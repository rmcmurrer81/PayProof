# PayProof runtime AI (optional; OpenAI-compatible Chat Completions endpoint)
PAYPROOF_MODEL_BASE_URL=
PAYPROOF_MODEL_API_KEY=
PAYPROOF_MODEL=local

# Optional Plaid Link bank feed. Start in sandbox; never commit real values.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Required for OAuth institutions such as Wells Fargo in a hosted deployment.
PLAID_REDIRECT_URI=

# Optional Tavily public-web research. Kept on the server and never sent to the browser.
TAVILY_API_KEY=

# Mandatory hackathon observability integration
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
PRISMTRACE_PROJECT_ID=
PRISMTRACE_ORG_ID=
PRISMTRACE_API_KEY=
